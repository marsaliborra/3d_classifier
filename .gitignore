# Raw dataset (downloaded on demand, ~450MB) and any cached preprocessed arrays
data/
*.npz
*.npy

# Training artifacts (checkpoints, generated plots) - not source, regenerated by running the code
outputs/checkpoints/*
outputs/figures/*
!outputs/checkpoints/.gitkeep
!outputs/figures/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# OS
.DS_Store
