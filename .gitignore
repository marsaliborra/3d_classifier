# Raw dataset (downloaded on demand, ~450MB) and any cached preprocessed arrays
data/
*.npz
*.npy

# Training artifacts - not source, regenerated by running the code.
# Excepcion: las 3 figuras finales SI se versionan a proposito, para que
# el README las muestre en GitHub sin que haga falta ejecutar el notebook.
outputs/checkpoints/*
outputs/figures/*
!outputs/checkpoints/.gitkeep
!outputs/figures/.gitkeep
!outputs/figures/confusion_matrix.png
!outputs/figures/training_curves.png
!outputs/figures/example_predictions.png

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# OS
.DS_Store
